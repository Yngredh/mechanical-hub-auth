# ---------------------------------------------------------------------------
# Configuracao das funcoes de autenticacao / autorizacao.
#
# Todas as variaveis abaixo sao lidas por src/composition/config.ts. Nenhum
# adaptador acessa process.env diretamente, o que mantem o core independente
# de como a plataforma entrega a configuracao.
# ---------------------------------------------------------------------------

# --- Provedor de segredos -----------------------------------------------------
# environment      -> le os segredos das proprias variaveis de ambiente (AWS Academy Lab)
# aws-secrets-manager -> le do Secrets Manager (producao)
SECRET_PROVIDER=environment

# --- Banco de dados -----------------------------------------------------------
DATABASE_HOST=postgres
DATABASE_PORT=5432
DATABASE_NAME=mechanical_hub_db
DATABASE_SCHEMA=public
DATABASE_SSL=false

# Usados quando SECRET_PROVIDER=environment
DATABASE_USER=admin
DATABASE_PASSWORD=PmN2iDvdNz

# Usado quando SECRET_PROVIDER=aws-secrets-manager
# (segredo com o shape { "username": "...", "password": "..." })
DATABASE_CREDENTIALS_SECRET_ID=

# --- Assinatura do token ------------------------------------------------------
# Usado quando SECRET_PROVIDER=environment
TOKEN_SIGNING_KEY=chave-hs256-com-no-minimo-32-caracteres

# Usado quando SECRET_PROVIDER=aws-secrets-manager
TOKEN_SIGNING_KEY_SECRET_ID=

TOKEN_ISSUER=mechanical-hub-auth
TOKEN_AUDIENCE=mechanical-hub-api
TOKEN_TTL_SECONDS=7200

# --- Protecao contra forca bruta ---------------------------------------------
MAX_FAILED_ATTEMPTS=5
FAILED_ATTEMPTS_WINDOW_SECONDS=900

# --- Observabilidade ----------------------------------------------------------
LOG_LEVEL=info
SERVICE_NAME=mechanical-hub-auth
