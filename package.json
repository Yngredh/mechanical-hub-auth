{
  "name": "mechanical-hub-auth",
  "version": "1.0.0",
  "description": "Funcoes serverless de autenticacao e autorizacao do Mechanical Hub",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "build": "node scripts/build.mjs",
    "package": "npm run build && node scripts/package.mjs",
    "lint": "tsc --noEmit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "jsonwebtoken": "^9.0.2",
    "pg": "^8.12.0"
  },
  "devDependencies": {
    "@aws-sdk/client-secrets-manager": "^3.637.0",
    "@types/aws-lambda": "^8.10.145",
    "@types/bcryptjs": "^2.4.6",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/node": "^20.14.0",
    "@types/pg": "^8.11.6",
    "@vitest/coverage-v8": "^2.0.5",
    "esbuild": "^0.23.1",
    "typescript": "^5.5.4",
    "vitest": "^2.0.5"
  }
}
